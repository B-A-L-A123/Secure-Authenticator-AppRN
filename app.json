{
  "expo": {
    "name": "SecureAuthenticatorRN",
    "slug": "SecureAuthenticatorRN",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "secureauthenticator",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/images/icon.fore.png",
        "resizeMode": "contain",
        "backgroundColor": "#1a1a1a"
      }
    },
    "android": {
      "package": "com.bala.secureauthenticatorrn",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.fore.png",
        "backgroundColor": "#1a1a1a"
      },
      "splash": {
        "image": "./assets/images/icon.fore.png",
        "resizeMode": "contain",
        "backgroundColor": "#1a1a1a",
        "mdpi": "./assets/images/icon.fore.png",
        "hdpi": "./assets/images/icon.fore.png",
        "xhdpi": "./assets/images/icon.fore.png",
        "xxhdpi": "./assets/images/icon.fore.png",
        "xxxhdpi": "./assets/images/icon.fore.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      
      "@react-native-firebase/auth"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ec7b2a7-68e0-45d6-9da3-7f39f002615b"
      }
    },
    "owner": "b-a-l-a"
  }
}
